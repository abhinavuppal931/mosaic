{
  "name": "mosaic-room",
  "version": "0.1.0",
  "private": true,
  "description": "The Mosaic Room: a local web app that plays a council's session files live, then shows the verdict. Zero dependencies.",
  "type": "module",
  "license": "MIT",
  "engines": { "node": ">=20" },
  "scripts": {
    "start": "node server.js --open",
    "test": "node --test test/unit/*.test.mjs",
    "test:e2e": "node --test --test-concurrency=1 test/e2e/*.test.mjs",
    "screens": "node scripts/screens.mjs"
  }
}
